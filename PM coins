from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.uix.screenmanager import ScreenManager, Screen
from kivy.clock import Clock

class DashboardScreen(Screen):
    def __init__(self, **kwargs):
        super(DashboardScreen, self).__init__(**kwargs)
        self.balance = 0.00
        self.is_mining = False

        layout = BoxLayout(orientation='vertical', padding=20, spacing=15)
        
        layout.add_widget(Label(text='[b]PM Coin Dashboard[/b]', markup=True, font_size=26, size_hint_y=None, height=40))
        
        self.balance_label = Label(text='Balance: 0.00 PM', font_size=22, size_hint_y=None, height=40)
        layout.add_widget(self.balance_label)
        
        self.status_label = Label(text='Status: Paused', font_size=16, size_hint_y=None, height=30)
        layout.add_widget(self.status_label)
        
        self.mining_btn = Button(text='Start Mining', font_size=18, size_hint_y=None, height=50)
        self.mining_btn.bind(on_press=self.toggle_mining)
        layout.add_widget(self.mining_btn)
        
        transfer_btn = Button(text='Balance Transfer', font_size=16, size_hint_y=None, height=45)
        transfer_btn.bind(on_press=self.goto_transfer)
        layout.add_widget(transfer_btn)
        
        task_btn = Button(text='Instagram Tasks', font_size=16, size_hint_y=None, height=45)
        task_btn.bind(on_press=self.goto_tasks)
        layout.add_widget(task_btn)

        self.add_widget(layout)

    def toggle_mining(self, instance):
        if not self.is_mining:
            self.is_mining = True
            self.mining_btn.text = 'Stop Mining'
            self.status_label.text = 'Status: Mining Active...'
            Clock.schedule_interval(self.update_balance, 1)
        else:
            self.is_mining = False
            self.mining_btn.text = 'Start Mining'
            self.status_label.text = 'Status: Paused'
            Clock.unschedule(self.update_balance)

    def update_balance(self, dt):
        self.balance += 0.01
        self.balance_label.text = f'Balance: {self.balance:.2f} PM'

    def goto_transfer(self, instance):
        self.manager.current = 'transfer'

    def goto_tasks(self, instance):
        self.manager.current = 'tasks'

class TransferScreen(Screen):
    def __init__(self, **kwargs):
        super(TransferScreen, self).__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=20, spacing=15)
        
        layout.add_widget(Label(text='[b]Balance Transfer[/b]', markup=True, font_size=24, size_hint_y=None, height=40))
        
        self.recipient_input = TextInput(hint_text='Enter Wallet/User ID', multiline=False, size_hint_y=None, height=45)
        layout.add_widget(self.recipient_input)
        
        self.amount_input = TextInput(hint_text='Enter Amount to Transfer', multiline=False, input_filter='float', size_hint_y=None, height=45)
        layout.add_widget(self.amount_input)
        
        send_btn = Button(text='Transfer Now', font_size=16, size_hint_y=None, height=50)
        send_btn.bind(on_press=self.process_transfer)
        layout.add_widget(send_btn)
        
        back_btn = Button(text='Back to Dashboard', font_size=16, size_hint_y=None, height=45)
        back_btn.bind(on_press=self.go_back)
        layout.add_widget(back_btn)
        
        self.msg_label = Label(text='', font_size=14, size_hint_y=None, height=30)
        layout.add_widget(self.msg_label)

        self.add_widget(layout)

    def process_transfer(self, instance):
        recipient = self.recipient_input.text
        amount = self.amount_input.text
        if recipient and amount:
            self.msg_label.text = f'Successfully transferred {amount} PM to {recipient}!'
        else:
            self.msg_label.text = 'Please fill out all fields!'

    def go_back(self, instance):
        self.manager.current = 'dashboard'

class TaskScreen(Screen):
    def __init__(self, **kwargs):
        super(TaskScreen, self).__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=20, spacing=15)
        
        layout.add_widget(Label(text='[b]Instagram Tasks[/b]', markup=True, font_size=24, size_hint_y=None, height=40))
        layout.add_widget(Label(text='Complete tasks to earn PM Coins!', font_size=14, size_hint_y=None, height=30))
        
        self.task_btn = Button(text='Follow Instagram Page (+5 PM)', font_size=16, size_hint_y=None, height=50)
        self.task_btn.bind(on_press=self.complete_task)
        layout.add_widget(self.task_btn)
        
        self.task_status = Label(text='', font_size=14, size_hint_y=None, height=30)
        layout.add_widget(self.task_status)
        
        back_btn = Button(text='Back to Dashboard', font_size=16, size_hint_y=None, height=45)
        back_btn.bind(on_press=self.go_back)
        layout.add_widget(back_btn)

        self.add_widget(layout)

    def complete_task(self, instance):
        self.task_status.text = 'Task Verified! +5 PM added.'
        self.task_btn.disabled = True

    def go_back(self, instance):
        self.manager.current = 'dashboard'

class PMCoinApp(App):
    def build(self):
        sm = ScreenManager()
        sm.add_widget(DashboardScreen(name='dashboard'))
        sm.add_widget(TransferScreen(name='transfer'))
        sm.add_widget(TaskScreen(name='tasks'))
        return sm

if __name__ == '__main__':
    PMCoinApp().run()
